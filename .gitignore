```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py.class
*.pyc.class

# Virtual environments
venv/
.venv/
env/
.ENV/

# Build artifacts
build/
dist/
*.egg-info/

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.coverage.*
.coverage.*.*

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pytest
.pytest_cache/

# Coverage
coverage/
```