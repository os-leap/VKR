```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
env/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
target/

# Dependencies cache
node_modules/
.npm/
.yarn/
.pip/
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/

# OS generated
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
```